# Copy to .env; populate privately. Never paste credentials or private endpoints into logs.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
GITHUB_TOKEN=

# Public service endpoints (override only in .env)
GITHUB_API_URL=https://api.github.com
ZENODO_API_URL=https://zenodo.org/api
ARXIV_API_URL=https://export.arxiv.org/api
ARXIV_CONTENT_URL=https://arxiv.org

HTTP_TIMEOUT=30
OLLAMA_TIMEOUT=300
MAX_RETRY_WAIT=30
# Seconds; public rate-limit waits may exceed MAX_RETRY_WAIT in cruise mode.
DISCOVERY_INTERVAL=2.5
REPO_RECHECK_INTERVAL=1800
IDLE_INTERVAL=0.25
DISCOVERY_OVERLAP=600
# Prepared items per source; network collectors are independent of model inference.
PREFETCH_PER_SOURCE=8
# Maximum NEW evidence windows per item/review pass; increasing it does not enlarge GPU context.
MODEL_CHUNKS=8
# Dedicated model host: -1 is converted to a JSON number. 0 unloads; 3600 is seconds; 5m is a duration.
MODEL_KEEP_ALIVE=-1
